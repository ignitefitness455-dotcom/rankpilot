{
  "name": "rankpilot",
  "version": "0.1.0",
  "private": true,
  "description": "RankPilot: an evidence-first autonomous AI SEO agent (Gemini 4 Argon).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n db,web -c blue,magenta \"npm:db:start\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "worker": "tsx worker/index.ts",
    "build": "next build",
    "start": "next start",
    "setup": "tsx scripts/setup.ts",
    "db:start": "tsx scripts/db-start.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/setup.ts --migrate-only",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}

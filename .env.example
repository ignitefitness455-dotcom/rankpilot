# =====================================================================
# RankPilot environment. Copy to `.env` (setup does this automatically).
# Every value below works as-is for LOCAL DEVELOPMENT ONLY.
# Values marked "refused in production" make the app exit if NODE_ENV=production.
# =====================================================================

# --- Core ------------------------------------------------------------
APP_URL=http://localhost:3000
APP_NAME=RankPilot

# Runtime role: NOT the table owner, so Row-Level Security applies.
DATABASE_URL=postgres://rankpilot_app:rankpilot_app@localhost:5432/rankpilot
# Owner/admin role: used only by `npm run setup` (migrations, RLS policies, roles).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/rankpilot
# true = `npm run dev` / `npm run setup` start a bundled Postgres (no Docker needed).
# Set to false when using docker-compose, Neon or any other Postgres.
EMBEDDED_PG=true

# Auth.js
AUTH_SECRET=dev-only-change-me-32chars-minimum-xxxx
AUTH_DEV_LOGIN=true
# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AES-256-GCM key for stored secrets: base64 of exactly 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMmJ5dGVzISE=
ENCRYPTION_KEY_VERSION=1
# Previous keys for rotation, e.g. "1:base64key,2:base64key"
ENCRYPTION_KEYS_OLD=

# --- Google APIs (Phase 2+) -----------------------------------------
# PageSpeed Insights + CrUX (free API key)
GOOGLE_API_KEY=

# --- Gemini (Phase 3+) ----------------------------------------------
# Optional server-wide key. Users can bring their own key in Settings (BYOK).
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-4-argon
# Optional cheaper model for low-thinking tasks (empty = use primary for everything).
GEMINI_MODEL_FAST=
AI_BUDGET_RUN_USD=0.50
AI_BUDGET_PROJECT_DAY_USD=2.00
AI_BUDGET_USER_MONTH_USD=20.00
AI_MAX_STEPS=12

# --- Crawler (Phase 2+) ---------------------------------------------
CRAWLER_USER_AGENT="RankPilotBot/1.0 (+http://localhost:3000/en/bot)"
CRAWLER_MAX_PAGES_DEFAULT=500
CRAWLER_MAX_PAGES_HARD=10000
CRAWLER_MAX_PAGES_UNVERIFIED=50
CRAWLER_MAX_DEPTH_DEFAULT=10
CRAWLER_RPS=1
CRAWLER_CONCURRENCY=2
CRAWLER_ENABLE_RENDER=false
# Tests only: allow fetching private IPs (fixture servers). Refused in production.
CRAWLER_ALLOW_PRIVATE_IPS=false

# --- Optional paid providers (feature off when empty) ---------------
SERPAPI_KEY=
SERPER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
KEYWORDS_ENABLE_AUTOCOMPLETE=false

# --- Email (Phase 5) -------------------------------------------------
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="RankPilot <reports@localhost>"

# --- Observability ---------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
